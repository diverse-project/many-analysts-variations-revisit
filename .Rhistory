# Fonction pour extraire les coefficients et p-values de chaque modèle (ZIP)
extract_zip_results <- function(model, model_name) {
# Séparer les deux parties : logit (zero) et count (Poisson)
coefs_zero <- tidy(model, component = "zero") %>%
mutate(model = model_name, part = "logit")
coefs_count <- tidy(model, component = "count") %>%
mutate(model = model_name, part = "count")
bind_rows(coefs_zero, coefs_count)
}
# Appliquer à chaque modèle
models <- list(
Model1 = fit.zip.1,
Model2 = fit.zip.2,
Model3 = fit.zip.3,
Model4 = fit.zip.4
)
# Extraire les résultats pour chaque modèle
results <- imap_dfr(models, extract_zip_results)
source("~/many-analysts-variations-revisit/teams/team12/hand_work/Team12 copy.R")
# Fonction manuelle pour extraire les résultats d'un modèle zeroinfl
extract_zip_manual <- function(model, model_name) {
summ <- summary(model)
# Partie logit (zéro-inflation)
logit <- as.data.frame(summ$coefficients$zero)
logit$term <- rownames(logit)
logit$part <- "logit"
# Partie poisson (comptes)
count <- as.data.frame(summ$coefficients$count)
count$term <- rownames(count)
count$part <- "count"
# Combine
results <- bind_rows(logit, count) %>%
mutate(
model = model_name,
estimate = round(Estimate, 3),
p.value = ifelse(`Pr(>|z|)` < 0.001, "<.001", round(`Pr(>|z|)`, 3))
) %>%
select(model, part, term, estimate, p.value)
return(results)
}
# Appliquer à chaque modèle
models <- list(
Model1 = fit.zip.1,
Model2 = fit.zip.2,
Model3 = fit.zip.3,
Model4 = fit.zip.4
)
library(dplyr)
library(tidyr)
library(purrr)
results_all <- imap_dfr(models, extract_zip_manual)
# Réorganiser sous forme de tableau large
results_wide <- results_all %>%
pivot_wider(
names_from = model,
values_from = c(estimate, p.value),
names_glue = "{.value}_{model}"
) %>%
arrange(part, term)
# Sauvegarder au bon endroit
