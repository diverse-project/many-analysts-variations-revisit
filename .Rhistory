# Remove rows with missing essential values
data <- subset(data, !is.na(skin_cont) & !is.na(redCards) & !is.na(games) &
!is.na(refNum) & !is.na(playerShort) & !is.na(position))
# --- HYPOTHESIS 1: Effect of continuous skin tone ---
model_h1 <- glmer(
redCards ~ skin_cont + position + offset(log(games)) +
(1 | refNum) + (1 | playerShort),
data = data, family = poisson,
control = glmerControl(optimizer = "bobyqa")
)
