# Fonction pour extraire les coefficients et p-values
extract_zip_table <- function(model, model_name = "Model") {
# Coefficients
coefs <- summary(model)$coefficients
# Séparer en deux parties
logit_part <- coefs$zero
count_part <- coefs$count
# Créer data.frame pour logit
logit_df <- data.frame(
Term = rownames(logit_part),
Estimate = round(logit_part[, 1], 3),
`p-value` = ifelse(logit_part[, 4] < 0.001, "< .001 ***",
ifelse(logit_part[, 4] < 0.01, paste0(round(logit_part[, 4], 3), " **"),
ifelse(logit_part[, 4] < 0.05, paste0(round(logit_part[, 4], 3), " *"),
ifelse(logit_part[, 4] < 0.1, paste0(round(logit_part[, 4], 3), " ."),
round(logit_part[, 4], 3)))))
)
logit_df$Model <- model_name
# Créer data.frame pour count
count_df <- data.frame(
Term = rownames(count_part),
Estimate = round(count_part[, 1], 3),
`p-value` = ifelse(count_part[, 4] < 0.001, "< .001 ***",
ifelse(count_part[, 4] < 0.01, paste0(round(count_part[, 4], 3), " **"),
ifelse(count_part[, 4] < 0.05, paste0(round(count_part[, 4], 3), " *"),
ifelse(count_part[, 4] < 0.1, paste0(round(count_part[, 4], 3), " ."),
round(count_part[, 4], 3)))))
)
count_df$Model <- model_name
return(list(logit = logit_df, count = count_df))
}
# Appliquer à chaque modèle
results1 <- extract_zip_table(fit.zip.1, "Model 1")
results2 <- extract_zip_table(fit.zip.2, "Model 2")
results3 <- extract_zip_table(fit.zip.3, "Model 3")
results4 <- extract_zip_table(fit.zip.4, "Model 4")
# Fusionner
library(dplyr)
logit_table <- bind_rows(results1$logit, results2$logit, results3$logit, results4$logit)
count_table <- bind_rows(results1$count, results2$count, results3$count, results4$count)
# Réordonner les colonnes
logit_table <- logit_table[, c("Model", "Term", "Estimate", "p-value")]
names(logit_table)
# Réordonner les colonnes
logit_table <- logit_table[, c("Model", "Term", "Estimate", "p.value")]
count_table <- count_table[, c("Model", "Term", "Estimate", "p.value")]
# Afficher proprement
library(knitr)
library(kableExtra)
cat("\n\n### Table 1: Binomial zero-inflated coefficients (logit)\n")
logit_table %>%
kbl(caption = "Table 1: Binomial zero-inflated coefficients (logit)", align = "llcc") %>%
kable_styling(full_width = F)
cat("\n\n### Table 2: Poisson count model coefficients (log)\n")
count_table %>%
kbl(caption = "Table 2: Poisson count model coefficients (log)", align = "llcc") %>%
kable_styling(full_width = F)
